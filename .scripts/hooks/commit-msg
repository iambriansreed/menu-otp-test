#!/bin/sh
# Git insists on this exact filename, with no extension, so this is a two-line shim that
# hands the commit message to the real hook next to it. Keeping the logic in a .mjs file
# means `npm run typecheck` checks it like every other script here.
#
# Enable once per clone:  git config core.hooksPath .scripts/hooks
exec node "$(dirname "$0")/commit-msg.mjs" "$@"
