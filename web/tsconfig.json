{
    "skrapa": {
        "port": 4159,
        "base": "/",
        "output": "dist",
        "assets": "assets",
        "projectRoot": ".",
        "origin": "https://menu-otp.localhost/"
    },
    "compilerOptions": {
        "composite": true,
        "target": "ES2020",
        "module": "commonjs",
        "jsx": "react",
        "jsxFactory": "jsx",
        "jsxFragmentFactory": "Fragment",
        "strict": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "lib": ["DOM", "DOM.Iterable", "ES2020"]
    },
    "include": ["**/*.ts", "**/*.tsx", "version.json", "skrapa.d.ts"],
    "exclude": ["node_modules", "dist"]
}
